{
  "manifest_version": 3,
  "name": "Mirror Universe Tabs",
  "version": "1.0.8",
  "description": "Draws a beard on tab icons in groups named Mirror or Evil.",
  "permissions": ["tabGroups", "tabs", "scripting", "favicon"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mirror Universe Tabs — click to re-apply beards",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
